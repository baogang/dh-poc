FROM node:24-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --chown=node:node src ./src
COPY --chown=node:node web/road ./web/road
COPY --chown=node:node docs/road-agent-flow.html ./docs/road-agent-flow.html
ENV NODE_ENV=production
ENV ROAD_STATE_DIR=/tmp/road-poc-state
ENV POC_WEB_HOST=0.0.0.0
USER node
EXPOSE 10000
CMD ["node", "src/road/server.mjs"]
