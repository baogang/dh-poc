DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
EMOTION_MODEL=deepseek-flash
PLANNER_MODEL=deepseek-flash

# Local defaults: 127.0.0.1:8787. On Render, PORT and RENDER_EXTERNAL_URL are automatic.
# Public hosting additionally requires a website password (at least 16 characters).
# POC_WEB_HOST=0.0.0.0
# POC_PUBLIC_ORIGIN=https://your-service.onrender.com
# POC_AUTH_USERNAME=admin
# POC_AUTH_PASSWORD=

# Optional persistent answer feedback (Neon/PostgreSQL); backend only.
ROAD_FEEDBACK_DATABASE_URL=
ROAD_FEEDBACK_ENABLED=true

# Required persistent conversations. Blank reuses ROAD_FEEDBACK_DATABASE_URL.
# Use a Neon pooled PostgreSQL URL; keep all database URLs on the backend.
ROAD_SESSION_DATABASE_URL=
ROAD_SESSION_POOL_SIZE=5
ROAD_SESSION_CACHE_LIMIT=128
ROAD_SESSION_CACHE_IDLE_MS=300000
ROAD_SESSION_IDLE_TTL_MS=1800000
ROAD_SESSION_LEASE_MS=30000
ROAD_SESSION_EVENT_POLL_MS=2000
# Per-process admission limits, not a promised service capacity.
# For a Render Free pilot, explicitly start with 2 turns and 50 event streams.
ROAD_MAX_INFLIGHT_TURNS=8
ROAD_MAX_EVENT_STREAMS=500
# ROAD_STATE_DIR=.road-state  # Optional one-time/repeatable legacy JSON import.

# Temporarily pause emotion evaluation report downloads; true restores them.
POC_EMOTION_REPORT_DOWNLOADS=false
