DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
EMOTION_MODEL=deepseek-flash
PLANNER_MODEL=deepseek-flash

# Local defaults: 127.0.0.1:8787. On Render, PORT and RENDER_EXTERNAL_URL are automatic.
# Public hosting additionally requires a website password (at least 16 characters).
# POC_WEB_HOST=0.0.0.0
# POC_PUBLIC_ORIGIN=https://your-service.onrender.com
# POC_AUTH_USERNAME=admin
# POC_AUTH_PASSWORD=

# Optional persistent answer feedback (Neon/PostgreSQL); backend only.
ROAD_FEEDBACK_DATABASE_URL=
ROAD_FEEDBACK_ENABLED=true
