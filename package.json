{
  "name": "momah-entry-poc",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:mocks": "python3 -m unittest discover -s tests -v",
    "check": "node scripts/check.mjs",
    "poc": "node --env-file-if-exists=.env src/cli-v2.mjs",
    "eval:offline": "npm run poc -- eval --mode offline --suite engineering --split regression",
    "eval:live": "npm run poc -- eval --suite all --split regression",
    "probe": "npm run poc -- probe",
    "eval:emotion": "npm run poc -- eval --suite emotion --split all",
    "eval:planning": "npm run poc -- eval --suite planning --split all",
    "eval:integration": "npm run poc -- eval --suite integration --split all",
    "web": "node --env-file-if-exists=.env src/web-server.mjs",
    "road:web": "node --env-file-if-exists=.env src/road/server.mjs",
    "road:test": "node --test tests/road-*.test.mjs",
    "road:test:postgres": "node --env-file-if-exists=.env --test tests/road-session.postgres.mjs tests/road-feedback.postgres.mjs",
    "road:session-migrate": "node --env-file-if-exists=.env scripts/road-session-migrate.mjs",
    "road:capacity": "node --env-file-if-exists=.env scripts/road-capacity.mjs",
    "road:eval": "node --env-file-if-exists=.env scripts/road-eval.mjs",
    "road:emotion-eval": "node --env-file-if-exists=.env scripts/road-emotion-eval.mjs",
    "road:feedback-export": "node --env-file-if-exists=.env scripts/road-feedback-export.mjs",
    "road:knowledge-audit": "node scripts/road-knowledge-audit.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "ajv": "8.20.0",
    "pg": "8.23.1"
  }
}
