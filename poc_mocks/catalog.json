    {"id":"crm940_history_get","system":"940","skill":"crm940.municipal-complaint","method":"GET","path":"/crm940/complaints/{complaint_id}/history","description":"查询同一市政投诉的联系和处理历史；区分重复联系与新投诉。","effect":"read","required":[],"properties":{},"path_parameters":["complaint_id"]},
